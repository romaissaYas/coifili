# Copier ce fichier vers .env.local et adapter si besoin.
# Next.js charge .env.local automatiquement (pas besoin de dotenv).

# URL du backend Express (voir bsed/.env.example pour le configurer).
NEXT_PUBLIC_API_URL=http://localhost:5000

# URL publique du site (SEO : Open Graph, sitemap.xml, robots.txt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
