# Variables du stack STAGING (copier vers .env.staging — jamais committé).
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build
# Isolé de la prod (ports 3307/5001/3001, base gestion_staging).

DB_USER=root
DB_PASSWORD=change-me-staging
DB_NAME=gestion_staging

# OBLIGATOIRE — distinct de la prod. Ex. openssl rand -base64 48
JWT_SECRET=change-me-staging-secret
JWT_EXPIRES_IN=7d

# URLs publiques du staging
CORS_ORIGIN=http://localhost:3001
APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Derrière un proxy : TRUST_PROXY=1
TRUST_PROXY=
LOG_LEVEL=debug

# Optionnels
# SENTRY_DSN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Coifili Staging <no-reply@coifili.dev>
# UPLOAD_MAX_MB=5
