# Copier ce fichier vers .env et renseigner de vraies valeurs.
# .env n'est jamais commité (voir .gitignore).

# Environnement d'exécution (informatif : ne conditionne PAS la sécurité JWT).
# En production, mettre NODE_ENV=production.
NODE_ENV=development

# Port d'écoute du serveur Express
PORT=5000

# Origine autorisée par CORS (l'URL du frontend Next.js)
CORS_ORIGIN=http://localhost:3000

# Reverse proxy : nombre de proxys de confiance devant l'API (Nginx, Docker,
# PaaS). Requis en production pour que le rate limiting et les logs voient la
# vraie IP client (X-Forwarded-For). Ex. derrière un seul proxy : TRUST_PROXY=1.
# Laisser vide (défaut false) en local / sans proxy.
# TRUST_PROXY=1

# Connexion MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion

# Authentification JWT
# JWT_SECRET est OBLIGATOIRE pour toute exécution hors `npm run dev`
# (npm run start, serveur compilé, Docker, PM2...). Le serveur s'arrête au
# démarrage s'il est absent — indépendamment de NODE_ENV. Seul `npm run dev`
# tolère un secret de repli non sécurisé. Utiliser une chaîne longue et
# aléatoire (ex. `openssl rand -base64 48`).
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Emails transactionnels (confirmation de réservation).
# Si SMTP_HOST est absent, aucun email n'est réellement envoyé : ils sont
# seulement journalisés (transport « json »), pratique en développement.
# APP_URL = base des liens des boutons dans les emails (front public).
APP_URL=http://localhost:3000

# Upload d'images (produits/salon) : taille maximale en Mo (défaut 5).
# API_PUBLIC_URL = base publique de l'API pour construire l'URL des images
# uploadées (défaut : dérivée de la requête). À définir en production si l'API
# est derrière un proxy/domaine dédié.
UPLOAD_MAX_MB=5
# API_PUBLIC_URL=http://localhost:5000
# SMTP_HOST=smtp.exemple.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Coifili <no-reply@coifili.dev>

# Paiement par carte CIB/SATIM.
# PAIEMENT_CARTE_ACTIVE : proposer le paiement par carte. DÉSACTIVÉ par défaut
# (cash-only) tant que l'intégration SATIM n'est pas finalisée. Mettre à `true`
# une fois register.do/confirmOrder.do implémentés et testés en sandbox.
# PAIEMENT_CARTE_ACTIVE=false
# SATIM_WEBHOOK_SECRET : secret partagé pour valider la signature HMAC-SHA256
# des callbacks de la passerelle. Sans ce secret, le webhook n'est accepté qu'en
# `npm run dev` (refusé en production).
# SATIM_WEBHOOK_SECRET=

# Journalisation (pino). Niveau : trace|debug|info|warn|error|fatal|silent.
# Défaut : debug en `npm run dev`, info sinon. En prod, les logs sont en JSON
# (agrégeables par Loki/Datadog/CloudWatch...).
# LOG_LEVEL=info

# Suivi d'erreurs Sentry — OPT-IN : sans SENTRY_DSN, totalement inactif.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# Sauvegardes de la base (mysqldump → gzip, avec rotation).
#  - `npm run backup:db` fonctionne indépendamment de ces variables.
#  - Le cron de sauvegarde intégré est OPT-IN : BACKUP_ENABLED=true pour l'activer.
# Nécessite l'exécutable `mysqldump` sur l'hôte (client MySQL).
# BACKUP_ENABLED=false
# BACKUP_CRON=0 2 * * *
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=7
# MYSQLDUMP_PATH=mysqldump

# Module Marketing Instagram — À CONFIGURER pour activer les intégrations
# (le module fonctionne sans : gestion de contenu uniquement, sans publication
# ni génération IA tant que ces clés sont absentes).
#  - Connexion Meta par OAuth depuis l'admin (Facebook Page + Instagram).
#    L'admin connecte ses comptes via l'interface ; les jetons sont CHIFFRÉS et
#    stockés en base (table meta_connections) — plus besoin de coller un jeton.
#    API officielle uniquement. L'image publiée doit être une URL PUBLIQUE.
# META_APP_ID=                 # ID de l'app Meta (developers.facebook.com)
# META_APP_SECRET=             # Secret de l'app
# META_OAUTH_REDIRECT_URI=https://<domaine>/api/marketing/meta/callback
# META_TOKEN_SECRET=           # chaîne forte : clé de chiffrement des jetons (AES-256-GCM) + signature du state OAuth
# META_API_VERSION=v21.0
#  (Déprécié — remplacé par l'OAuth ci-dessus ; laisser vide) :
# META_ACCESS_TOKEN=
# META_IG_BUSINESS_ID=
# META_PAGE_ID=
# Domaine PUBLIC qui sert les images des publications (ex. le site déployé).
# Sert à transformer un chemin /img/... en URL absolue que Meta peut télécharger.
# PUBLIC_SITE_URL=https://votre-domaine.com
#  - Génération de texte par IA (fournisseur au choix ; « anthropic » implémenté) :
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-3-5-sonnet-latest
#  - Génération d'IMAGES (fournisseur d'images à brancher ; inactif sans clé) :
# AI_IMAGE_API_KEY=

# Compte Super Administrateur — utilisé UNIQUEMENT par `npm run seed:admin`
# pour créer/mettre à jour l'admin (aucune inscription admin publique).
# Rejouer le script réaligne le mot de passe sur ADMIN_PASSWORD.
ADMIN_EMAIL=admin@coifili.dev
ADMIN_PASSWORD=change-me-strong
# Optionnels :
# ADMIN_FIRSTNAME=Super
# ADMIN_LASTNAME=Admin
# ADMIN_PHONE=0000000000
